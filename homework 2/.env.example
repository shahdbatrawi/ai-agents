# Your OpenRouter key (create one at https://openrouter.ai/keys). Never commit the real .env
OPENROUTER_API_KEY=

# Model that turns text into embeddings (needed for search by meaning). Free model:
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Minimum similarity score (0 to 1) for a search result to count.
# 0.20 was chosen from real scores with the model above. If you change the model, re-measure
# the scores with: python tests/probe_scores.py "your query"
SEARCH_MIN_SCORE=0.20

# Optional: database file path. Leave this line out to use flask_app/database/resume.db
# RESUME_DB_PATH=